{
  "version": 1,
  "commands": {
    "contract inspect": {
      "description": "JSON output emitted by `starforge contract inspect <CONTRACT_ID> --json`.",
      "fields": [
        {
          "path": "contract_id",
          "type": "string",
          "stability": "stable",
          "description": "Inspected contract ID."
        },
        {
          "path": "executable",
          "type": "string",
          "stability": "stable",
          "description": "Executable type reported by contract instance metadata."
        },
        {
          "path": "wasm_hash",
          "type": "string|null",
          "stability": "stable",
          "description": "WASM hash for WASM-backed contracts, or null when unavailable."
        },
        {
          "path": "storage_durability",
          "type": "string",
          "stability": "stable",
          "description": "Durability class of the inspected storage."
        },
        {
          "path": "latest_ledger",
          "type": "number",
          "stability": "stable",
          "description": "Latest ledger observed while inspecting the contract."
        },
        {
          "path": "last_modified_ledger_seq",
          "type": "number|null",
          "stability": "stable",
          "description": "Ledger sequence where the instance entry was last modified, or null when unavailable."
        },
        {
          "path": "live_until_ledger_seq",
          "type": "number|null",
          "stability": "stable",
          "description": "Ledger sequence through which the instance entry remains live, or null when unavailable."
        },
        {
          "path": "instance_storage",
          "type": "array<object>",
          "stability": "stable",
          "description": "Decoded instance storage entries."
        },
        {
          "path": "instance_storage[].key",
          "type": "string",
          "stability": "stable",
          "description": "Decoded storage key."
        },
        {
          "path": "instance_storage[].value",
          "type": "string",
          "stability": "stable",
          "description": "Decoded storage value."
        },
        {
          "path": "metadata",
          "type": "object|string|null",
          "stability": "stable",
          "description": "Build provenance metadata reported by the contract WASM, when available."
        }
      ]
    },
    "sep10 auth": {
      "description": "JSON output emitted by `starforge sep10 auth --json`.",
      "fields": [
        {
          "path": "home_domain",
          "type": "string",
          "stability": "experimental",
          "description": "Anchor home domain that was authenticated."
        },
        {
          "path": "web_auth_endpoint",
          "type": "string",
          "stability": "experimental",
          "description": "SEP-10 authentication endpoint taken from stellar.toml."
        },
        {
          "path": "account",
          "type": "string",
          "stability": "experimental",
          "description": "Stellar account (G...) that authenticated."
        },
        {
          "path": "signing_key",
          "type": "string",
          "stability": "experimental",
          "description": "Anchor SIGNING_KEY that had to sign the challenge."
        },
        {
          "path": "network_passphrase",
          "type": "string",
          "stability": "experimental",
          "description": "Network passphrase the challenge was signed for."
        },
        {
          "path": "challenge_data_name",
          "type": "string",
          "stability": "experimental",
          "description": "manage_data key of the challenge (`<home_domain> auth`)."
        },
        {
          "path": "challenge_seconds_remaining",
          "type": "number",
          "stability": "experimental",
          "description": "Seconds left on the challenge time bounds when it was validated."
        },
        {
          "path": "signatures_after_signing",
          "type": "number",
          "stability": "experimental",
          "description": "Signature count on the submitted challenge (anchor + wallet)."
        },
        {
          "path": "jwt",
          "type": "string",
          "stability": "experimental",
          "description": "JWT the anchor issued."
        },
        {
          "path": "jwt_claims",
          "type": "object|null",
          "stability": "experimental",
          "description": "Decoded (not verified) JWT claims, or null when the token is opaque."
        },
        {
          "path": "jwt_claims.iss",
          "type": "string|null",
          "stability": "experimental",
          "description": "Token issuer claim."
        },
        {
          "path": "jwt_claims.sub",
          "type": "string|null",
          "stability": "experimental",
          "description": "Subject claim: the authenticated account."
        },
        {
          "path": "jwt_claims.iat",
          "type": "number|null",
          "stability": "experimental",
          "description": "Issued-at claim."
        },
        {
          "path": "jwt_claims.exp",
          "type": "number|null",
          "stability": "experimental",
          "description": "Expiry claim."
        },
        {
          "path": "jwt_file",
          "type": "string|null",
          "stability": "experimental",
          "description": "Path the JWT was also written to, or null when --output was not used."
        }
      ]
    }
  }
}
