tests/fixtures/snapshots/bindings_python.py    text eol=lf
tests/fixtures/snapshots/bindings_go.go        text eol=lf
*.rs  text eol=lf
*.ts  text eol=lf
*.py  text eol=lf
*.go  text eol=lf
*.toml text eol=lf
*.md  text eol=lf
